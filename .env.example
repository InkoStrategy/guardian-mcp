# ---- RPC (optional; public defaults are used when unset) ----
# Override any chain: RPC_URL_<chainId>. Comma-separated list = fallback order.
# RPC_URL_1=https://mainnet.infura.io/v3/<key>,https://ethereum-rpc.publicnode.com
# RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/<key>
# Per-call RPC timeout in ms (default 4000) and total analysis budget in ms (default 7000)
# RPC_TIMEOUT_MS=4000
# RPC_BUDGET_MS=7000

# ---- x402 payments (disabled while X402_PRICE is 0 or unset) ----
# Price in atomic units of X402_ASSET (e.g. 10000 = 0.01 USDC with 6 decimals)
# X402_PRICE=0
# X402_PAY_TO=0xYourReceivingAddress
# X402_NETWORK=eip155:8453
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET_NAME=USD Coin
# X402_ASSET_VERSION=2
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_MAX_TIMEOUT_SECONDS=300

# ---- Agent-integrity layer (context analysis) ----
# Trusted domains for context.recent_sources (comma-separated). Official brand domains
# and the default RPC hosts are always trusted in addition to this list.
TRUSTED_DOMAINS=coingecko.com,api.etherscan.io
# How long untrusted domains are remembered per session_id (memory_poisoning_signal), ms
SESSION_TTL_MS=3600000
# Raw-unit threshold above which an approve/transfer counts as "large" for untrusted_source_before_tx (DENY instead of WARN)
# LARGE_AMOUNT_RAW=1000000000000000000
# Maximum acceptable permit / order validity for /analyze-signature (far_deadline), days
# PERMIT_MAX_DEADLINE_DAYS=30

# ---- Shared state (threat registry + session health) ----
# Without these the service uses per-instance memory (works, but no cross-agent network effect).
# Vercel Storage -> Upstash Redis injects one of these pairs automatically:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STORE_TIMEOUT_MS=2500

# Threat registry thresholds
# THREAT_WARN_REPORTS=1
# THREAT_DENY_REPORTS=3
# THREAT_DENY_REPORTERS=2
# THREAT_TTL_DAYS=90
# THREAT_SALT=change-me

# Session health thresholds (window = SESSION_TTL_MS)
# SESSION_WARN_THRESHOLD=3
# SESSION_DENY_THRESHOLD=2
# SESSION_RISK_THRESHOLD=150

# Owner alerts
# ALERT_SIGNING_SECRET=change-me
# ALERT_TIMEOUT_MS=2500

# ---- Admin / cron ----
# ADMIN_TOKEN=change-me            # X-Admin-Token for /admin/stats and manual /cron/seed
# CRON_SECRET=change-me            # Vercel Cron sends it as Authorization: Bearer to /cron/seed

# ---- Pricing (dormant: PRICING_MODE=free) ----
# PRICING_MODE=free                # free | premium | auto
# X402_PREMIUM_PRICE=10000         # atomic units of X402_ASSET for premium layers
# FREE_CALLS=1000
# FREE_SESSIONS=20
# FREE_DAYS=30
# GRANDFATHERED_PAYERS=0x...,0x... # early adopters, free for life

# ---- Premium endpoint POST /guard (paid via OKX Payment SDK / facilitator) ----
# Created in the OKX Dev Portal (https://web3.okx.com/onchainos/dev-portal). Without them /guard answers 503.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# PREMIUM_PRICE=$0.099            # USD price; the SDK converts to the network stablecoin (USDT0 on X Layer)
# PREMIUM_NETWORK=eip155:196      # X Layer mainnet; must be supported by the OKX facilitator
# PREMIUM_PAY_TO=0x...            # receiving address (falls back to X402_PAY_TO)
# PREMIUM_ENABLED=auto            # auto | false
# PREMIUM_SYNC_SETTLE=false       # true = wait for on-chain confirmation before responding
