# ---- RPC (optional; public defaults are used when unset) ----
# Override any chain: RPC_URL_<chainId>. Comma-separated list = fallback order.
# RPC_URL_1=https://mainnet.infura.io/v3/<key>,https://ethereum-rpc.publicnode.com
# RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/<key>
# Per-call RPC timeout in ms (default 4000) and total analysis budget in ms (default 7000)
# RPC_TIMEOUT_MS=4000
# RPC_BUDGET_MS=7000

# ---- x402 payments (disabled while X402_PRICE is 0 or unset) ----
# Price in atomic units of X402_ASSET (e.g. 10000 = 0.01 USDC with 6 decimals)
# X402_PRICE=0
# X402_PAY_TO=0xYourReceivingAddress
# X402_NETWORK=eip155:8453
# X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET_NAME=USD Coin
# X402_ASSET_VERSION=2
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_MAX_TIMEOUT_SECONDS=300
