{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1"
    }
  },
  "crons": [
    {
      "path": "/cron/seed",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!demo-v61|demo-short|deck).*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/demo-v61.en.vtt",
      "headers": [
        {
          "key": "content-type",
          "value": "text/vtt; charset=utf-8"
        }
      ]
    },
    {
      "source": "/deck.pdf",
      "headers": [
        {
          "key": "content-type",
          "value": "application/pdf"
        },
        {
          "key": "content-disposition",
          "value": "inline; filename=\"GuardianMCP-PaySafe-LNO-Alpha.pdf\""
        }
      ]
    }
  ]
}
